# Gezintoo backend ayarlari
#
# Bu dosya sablondur ve repo'ya dahildir. Kurulumda kopyalayip doldurun:
#     cd backend && cp .env.example .env
#
# .env dosyasi .gitignore'da oldugu icin commit edilmez.

# ─── Google Maps Platform ───────────────────────────────────────
# Directions API icin sunucu anahtari.
# Olusturma: console.cloud.google.com -> APIs & Services -> Credentials
# Onerilen kisitlama: Application restriction = IP addresses,
#                     API restriction = sadece Directions API
GOOGLE_API_KEY=

# ─── MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gezintoo_db
